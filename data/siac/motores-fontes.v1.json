  "camadas": [
    {
      "nome": "Identidade química",
      "requer": [
        "nome",
        "CAS",
        "PubChem CID",
        "SMILES/InChIKey",
        "pureza/fonte"
      ],
      "limites": "Sinônimos não garantem identidade; misturas de solvente exigem composição."
    },
    {
      "nome": "Termofísica",
      "requer": [
        "ρ(T,P)",
        "μ(T,P)",
        "γ(T)",
        "ângulo de contato",
        "pressão de vapor",
        "constante dielétrica"
      ],
      "limites": "ρ puro ≠ ρ mistura, μ não mistura linearmente por padrão."
    },
    {
      "nome": "Equilíbrio de fases",
      "requer": [
        "pares solventes",
        "faixa de composição",
        "temperatura",
        "parâmetros UNIFAC/NRTL ou medição"
      ],
      "limites": "Uma matriz binária miscível/não miscível não contém curvas de equilíbrio."
    },
    {
      "nome": "Retenção e adsorção",
      "requer": [
        "analito",
        "fase estacionária",
        "fase móvel e composição",
        "temperatura",
        "pH quando aplicável",
        "isoterma ou medidas k/Rf"
      ],
      "limites": "logP, polaridade e miscibilidade não determinam k ou Rf universal."
    },
    {
      "nome": "Transporte e capilaridade",
      "requer": [
        "porosidade e distribuição de poros",
        "raio efetivo",
        "molhabilidade",
        "viscosidade",
        "tensão superficial",
        "geometria"
      ],
      "limites": "Lucas–Washburn descreve sistema ideal; papel real pode desviar por saturação/evaporação/heterogeneidade."
    },
    {
      "nome": "Coluna e frações",
      "requer": [
        "vazão",
        "permeabilidade",
        "dispersão",
        "cinética de troca",
        "isoterma",
        "massa de alimentação"
      ],
      "limites": "CADET precisa de parâmetros e validação; não existe predição automática do cromatograma por ID."
    }
  ],
  "aceite": [
    "Proibir preenchimento automático de k/Rf baseado apenas no nome, cor ou densidade.",
    "Não permitir converter CIDs ou cores de pigmento em resultados de separação sem fonte contextual.",
    "Qualquer parâmetro calculado exige T/P, método, versão da biblioteca, limite de validade, origem e incerteza quando disponível.",
    "Simulação no navegador precisa ser offline e reproduzível; pré-cálculo pode gerar pacotes estáticos, nunca misturar com dados de usuário.",
    "Executar validação cruzada em pelo menos três sistemas simples antes de introduzir UNIFAC/NRTL ou CADET.",
    "Revisar licenças AGPL/GPL/EPL e proveniência de dados antes de copiar código para o SIAC."
  ]
}
